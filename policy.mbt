///|
/// # 取樣政策（第十輪定案，第十六輪改為成本感知）
///
/// 在第十輪之前，每一條義務的取樣量是各自決定的 —— A-01 跑 2,000 次、
/// I-01 跑 60 次、H-20 跑 5 次。沒有壞處，但也沒有道理：那些數字是
/// 寫那一條時隨手定的，彼此不可比，而且總時間一路漲到 116 秒。
///
/// 第十輪把取樣量變成一條可執行的政策（A-01 = 24、其餘 A = 8、
/// B = 23、C–I = 10）。那一版把成本壓下來了，但它用的是**群組**分層，
/// 而群組與成本無關：A-02 每實例 0.02 ms，D-01 每實例 21.6 ms，
/// 相差一千倍，卻分別被配到 8 與 10 次。結果是便宜的條目取樣過少
/// （134 條裡有 129 條不足 24 次），而貴的條目也沒省到多少。
///
/// ## 第十六輪：以每實例成本分層
///
/// ```text
///   層     判準（ms／實例）   目標    條數   理由
///   -----  ----------------  ------  -----  --------------------------------
///   便宜   < 0.1             64      30     幾乎免費，取樣多寡不影響總時間
///   中等   0.1 – 1.0         24      77     補到統計上站得住的下限
///   昂貴   > 1.0             24      27     封頂；再多只是重複同一條路徑
/// ```
///
/// 兩個設計決定值得記下來。
///
/// **其一：下限是 24，不是 10。** 24 次下，一個發生機率 10% 的缺陷
/// 漏檢機率為 0.9²⁴ ≈ 8%；10 次下是 35%。把 129 條從 8–10 次補到 24 次，
/// 是**提高**驗證強度，不是放寬。總實例數 1,634 → 4,453（×2.7），
/// 而 A–I 的時間由 1.27 s 升到約 2.9 s —— 對 161 秒的全庫是 +1%。
///
/// **其二：層別是一張登記表，不是當場量出來的。** 本庫禁止在程式庫
/// 內計時（`@bench` 只能出現在 `cmd/*`），故層別必須寫成常數表。
/// 但常數表會腐壞 —— 某條變快或變慢之後，它的層別就不再成立。
/// 故 `cmd/audit` 逐條把**實測每實例成本**與登記層別對帳，
/// 落在錯誤層別的條目當場現形（見 `trial_tier_ok`）。
/// 政策不是註解，是一張會被對帳的表。
///
/// ## 下限優先
///
/// 目標數是上限，不是硬性規定。若某條的結構性最小覆蓋高於目標
/// （例如 B 群要走完 23 條公理，或 E-02 要走完 dim×dim 個基底對），
/// 就用那個最小值，並在 `trial_floor` 登記。

///|
/// 成本層別：0 = 便宜（< 0.1 ms／實例）、1 = 中等、2 = 昂貴（> 1 ms／實例）。
///
/// 由第十六輪之實測（`docs/逐條量測.tsv`）產生；`cmd/audit` 逐條對帳。
pub fn trial_tier(code : String) -> Int {
  match code {
    "A-01"
    | "A-02"
    | "A-03"
    | "A-04"
    | "A-05"
    | "A-06"
    | "A-07"
    | "A-08"
    | "A-09"
    | "B-01"
    | "B-02"
    | "B-08"
    | "B-09"
    | "B-10"
    | "B-12"
    | "B-13"
    | "E-13"
    | "G-01"
    | "G-05"
    | "G-06"
    | "H-01"
    | "H-03"
    | "H-04"
    | "H-05"
    | "H-15"
    | "H-17"
    | "H-18"
    | "H-21"
    | "H-25"
    | "I-01" => 0
    "C-08"
    | "C-10"
    | "C-11"
    | "C-13"
    | "C-18"
    | "C-19"
    | "C-20"
    | "D-01"
    // D-03 於第十八輪由昂貴層降到中等層（1.0 → 0.40 ms／實例）：
    // 加速層接進 N 群之後，projection_matrix 與 L² 內積的改動一併
    // 讓它變快。層別表因此腐壞，而 cmd/audit 的 tier 欄當場印出
    // TIERDRIFT —— 這正是第十六輪加那一欄的理由。
    | "D-05"
    | "D-06"
    | "D-07"
    | "D-08"
    | "D-09"
    | "D-19"
    | "D-20"
    | "D-22"
    | "E-01"
    | "E-03"
    | "E-06"
    | "E-14"
    | "E-15"
    | "F-08"
    | "F-09"
    | "G-02"
    | "H-07"
    | "H-13" => 2
    _ => 1
  }
}

///|
/// 層別之成本區間（ms／實例）之下界與上界，供 `cmd/audit` 對帳。
///
/// 區間刻意留 2 倍的遲滯：便宜層容許到 0.2、昂貴層容許低到 0.5。
/// 沒有遲滯的話，量測雜訊會讓邊界上的條目每次跑都換層。
pub fn trial_tier_band(tier : Int) -> (Double, Double) {
  match tier {
    0 => (0.0, 0.2)
    2 => (0.5, 1.0e9)
    _ => (0.0, 2.0)
  }
}

///|
/// 實測每實例成本是否落在登記層別之內（含遲滯）。
pub fn trial_tier_ok(code : String, ms_per_inst : Double) -> Bool {
  let (lo, hi) = trial_tier_band(trial_tier(code))
  ms_per_inst >= lo && ms_per_inst <= hi
}

///|
/// 目標取樣量。
pub fn trial_target(code : String) -> Int {
  if code.length() < 1 {
    return 0
  }
  let g = code[:1].to_owned()
  if g == "A" ||
    g == "B" ||
    g == "C" ||
    g == "D" ||
    g == "E" ||
    g == "F" ||
    g == "G" ||
    g == "H" ||
    g == "I" {
    // 【第十六輪】由群組分層改為成本分層
    match trial_tier(code) {
      0 => 64
      _ => 24
    }
  } else {
    0
  }
}

///|
/// **結構性固定**之取樣量：由被驗證的對象本身決定，與成本無關。
///
/// 這類條目的實例數不是「跑幾次」而是「有幾個」—— B 群的公理檢驗器
/// 走完 23 條公理就是 23 個實例，再跑一遍只是把同樣的 23 條重做；
/// E-02／E-07 掃完 dim × dim 個基底對亦然。對它們套用成本分層是
/// 類別錯誤，故本表優先於 `trial_target`。
///
/// 回傳 0 表示非結構性固定。
pub fn trial_structural(code : String) -> Int {
  match code {
    // 內嵌公理檢驗器：V1–V11 + B1–B5 + I1–I7 = 23 條公理，各一次
    "B-01"
    | "B-02"
    | "B-03"
    | "B-04"
    | "B-05"
    | "B-06"
    | "B-07"
    | "B-08"
    | "B-09"
    | "B-10"
    | "B-11"
    | "B-13"
    | "B-14"
    | "B-15" => 23
    // 兩個空間（so(4) 與 sl₃）各 23 條公理
    "B-12" => 46
    // 基底對 dim × dim 全掃，dim = 7
    "E-02" => 49
    // 基底對 dim × dim 全掃，dim = 6
    "E-07" => 36
    // ℝ⁴ 之 V1–V11 + I1–I7，加 P₅ 之 I1–I7
    "H-25" => 25
    // 【第十六輪】下列條目之實例數由**被列舉的對象**決定，不是抽樣次數：
    //   E-01/E-03/E-06  走完空間維數決定的基底或階數
    //   E-08            走完 dim ∈ {2,3,4,5} × 階數偏移
    //   F-07/F-09       走完固定的度量清單／組合空間清單
    //   G-01/G-05/G-06/G-08  走完 (p,q) 範數對或矩陣階數範圍
    //   H-19/H-20/H-24  走完固定的矩陣尺寸清單
    //   H-21/H-22       走完 Kronecker 階數 k ∈ 1..5
    //   I-04/I-05       走完四元數單位 {1,i,j,k} 之乘法表
    // 對它們套用成本分層會要求「多列舉幾個不存在的對象」，是類別錯誤。
    "E-01"
    | "E-06"
    | "F-07"
    | "F-09"
    | "G-01"
    | "H-19"
    | "H-20"
    | "H-21"
    | "H-22"
    | "H-24"
    | "I-04" => 10
    // dim ∈ {2,3,4,5} × 節點數偏移，扣掉 m < 1 者共 19 格
    "E-08" => 19
    // 四元數單位 {½(1+i+j+k), 3/5+4/5i, 5/13+12/13j, 8/17+15/17k} 之 4 × 4 乘法表
    "I-05" => 16
    _ => 0
  }
}

///|
/// 已登記之結構性下限（目標數達不到時使用）。
///
/// 每一筆都附理由；沒有理由的例外不該存在。
pub fn trial_floor(code : String) -> Int {
  match code {
    // 基底對 dim×dim 全掃，dim = 7
    "E-02" => 49
    // 基底對 dim×dim 全掃，dim = 6
    "E-07" => 36
    // 內嵌公理檢驗器：23 條公理 × 每條至少 1 次
    // 兩個空間（so(4) 與 sl₃）各 23 條公理
    "B-12" => 46
    "B-13" => 23
    // ℝ⁴ 之 V1–V11 + I1–I7，加 P₅ 之 I1–I7
    "H-25" => 25
    _ => 0
  }
}

///|
/// 政策所要求的實測值。
///
/// 優先序：結構性固定 > max(成本分層目標, 登記下限)。
pub fn trial_policy(code : String) -> Int {
  let st = trial_structural(code)
  if st > 0 {
    return st
  }
  let t = trial_target(code)
  let f = trial_floor(code)
  if f > t {
    f
  } else {
    t
  }
}

///|
/// 政策是否適用於此代號（N 群與加速層 K/L/M 不在本輪政策範圍內）。
pub fn trial_governed(code : String) -> Bool {
  trial_target(code) > 0
}
