///|
/// # 取樣政策（第十輪）
///
/// 在此之前，每一條義務的取樣量是各自決定的 —— A-01 跑 2,000 次、
/// I-01 跑 60 次、H-20 跑 5 次。沒有壞處，但也沒有道理：那些數字是
/// 寫那一條時隨手定的，彼此不可比，而且總時間一路漲到 116 秒。
///
/// 本輪把取樣量變成一條**可執行的政策**：
///
/// ```text
///   A-01          24     PRNG 退化檢驗（8 桶覆蓋需要較多抽樣）
///   A-02 … A-10    8     純量層恆等式
///   B-01 … B-15   23     公理檢驗器 —— 23 條公理各一次（結構性下限）
///   C-01 … I-07   10     其餘全部
/// ```
///
/// ## 下限優先
///
/// 目標數是**上限**，不是硬性規定。若某條的結構性最小覆蓋高於目標
/// （例如 B 群要走完 V1–V11 + B1–B5 + I1–I7 共 23 條公理，
/// 或 E-02 要走完 dim×dim 個基底對），就用那個最小值，並在此表登記。
/// 登記是為了讓例外**可被審計** —— `cmd/audit` 會逐條比對實測與政策，
/// 未登記的偏離當場現形。
///
/// 換句話說：政策不是註解，是一張會被對帳的表。

///|
/// 目標取樣量。
pub fn trial_target(code : String) -> Int {
  if code.length() < 1 {
    return 0
  }
  let g = code[:1].to_owned()
  if code == "A-01" {
    24
  } else if g == "A" {
    8
  } else if g == "B" {
    23
  } else if g == "C" ||
    g == "D" ||
    g == "E" ||
    g == "F" ||
    g == "G" ||
    g == "H" ||
    g == "I" {
    10
  } else {
    0
  }
}

///|
/// 已登記之結構性下限（目標數達不到時使用）。
///
/// 每一筆都附理由；沒有理由的例外不該存在。
pub fn trial_floor(code : String) -> Int {
  match code {
    // 基底對 dim×dim 全掃，dim = 7
    "E-02" => 49
    // 基底對 dim×dim 全掃，dim = 6
    "E-07" => 36
    // 內嵌公理檢驗器：23 條公理 × 每條至少 1 次
    // 兩個空間（so(4) 與 sl₃）各 23 條公理
    "B-12" => 46
    "B-13" => 23
    // ℝ⁴ 之 V1–V11 + I1–I7，加 P₅ 之 I1–I7
    "H-25" => 25
    _ => 0
  }
}

///|
/// 政策所要求的實測值：max(目標, 登記下限)。
pub fn trial_policy(code : String) -> Int {
  let t = trial_target(code)
  let f = trial_floor(code)
  if f > t {
    f
  } else {
    t
  }
}

///|
/// 政策是否適用於此代號（N 群與加速層 K/L/M 不在本輪政策範圍內）。
pub fn trial_governed(code : String) -> Bool {
  trial_target(code) > 0
}
